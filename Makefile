# Compiler/config
CXX       := g++
CXXFLAGS  := -std=c++23 -Werror
CPPFLAGS  := -Iinclude -MMD -MP

# Dirs
SRCDIR    := src
INCDIR    := include
OBJDIR    := obj
BINDIR    := bin

# Binaries
CLIENT    := $(BINDIR)/client
SERVER    := $(BINDIR)/tsamgroup9

# Source files
CLIENT_SOURCES := \
  $(SRCDIR)/client.cpp \
  $(SRCDIR)/helpers.cpp \
  $(SRCDIR)/client_logs.cpp \

SERVER_SOURCES := \
  $(SRCDIR)/tsamgroup9.cpp \
  $(SRCDIR)/helpers.cpp \
  $(SRCDIR)/client_logs.cpp \
  $(SRCDIR)/operations.cpp \
  $(SRCDIR)/block_bots.cpp

# Object files (mirror directory structure under obj/)
CLIENT_OBJECTS := $(CLIENT_SOURCES:%.cpp=$(OBJDIR)/%.o)
SERVER_OBJECTS := $(SERVER_SOURCES:%.cpp=$(OBJDIR)/%.o)

# Dependency files (auto-generated by -MMD -MP)
DEPS := $(CLIENT_OBJECTS:.o=.d) $(SERVER_OBJECTS:.o=.d)

.PHONY: all client server clean

all: $(CLIENT) $(SERVER)

client: $(CLIENT)
server: $(SERVER)

# Link
$(CLIENT): $(CLIENT_OBJECTS) | $(BINDIR)
	$(CXX) $(CXXFLAGS) $^ -o $@

$(SERVER): $(SERVER_OBJECTS) | $(BINDIR)
	$(CXX) $(CXXFLAGS) $^ -o $@

# Compile (ensure obj subdirs exist)
$(OBJDIR)/%.o: %.cpp
	@mkdir -p $(@D)
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -c $< -o $@

# Create bin/
$(BINDIR):
	mkdir -p $@

clean:
	rm -rf $(OBJDIR) $(BINDIR)

# Include auto-generated header dependencies (optional)
-include $(DEPS)
